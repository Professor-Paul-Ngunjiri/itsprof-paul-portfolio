{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "dist/server/**"
    }
  },
  "rewrites": [
    { "source": "/((?!assets/|favicon|logo|og-image|robots).*)", "destination": "/api" }
  ]
}
