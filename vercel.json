{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "nodeVersion": "20.x",
  "functions": {
    "api/index.ts": {
      "runtime": "nodejs20.x",
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}
