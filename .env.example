# Server-only Google reviews integration.
# Create a Google Maps Platform API key with Places API access enabled.
GOOGLE_MAPS_API_KEY=

# Use the Place ID for the Google Business Profile.
# The public profile link is configured in src/data/siteConfig.ts.
GOOGLE_PLACE_ID=

# Optional fallback if you do not have the Place ID yet.
# Example: ItsProf Paul Nairobi or Pahwah Digitech Nairobi
GOOGLE_PLACE_QUERY=
